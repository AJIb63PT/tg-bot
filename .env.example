# ---------------------------------------------------------------------------
# Скопируйте этот файл в .env и заполните. Ничего больше ставить не нужно.
# ---------------------------------------------------------------------------

# 1) Токен бота от @BotFather (обязательно для запуска бота)
#    BotFather -> /newbot -> имя -> username -> получите токен вида 123456:AA...
BOT_TOKEN=

# 2) Кто имеет доступ. Пустой список = доступ всем (удобно для отладки).
#    Свой Telegram ID можно узнать командой /id в боте.
#    Несколько значений через запятую: 11111111,22222222
ALLOWED_USER_IDS=

# 3) Часовой пояс для расписания и разбора дат (IANA)
TZ=Asia/Yekaterinburg

# 4) Время утренней сводки, ЧЧ:ММ по TZ
DIGEST_TIME=09:00

# 5) Язык/регион для разбора дат (пн/вт/... и «пятница»)
LOCALE=ru

# 6) Путь к файлу базы SQLite
DB_PATH=./data/bot.db

# 7) Погода
#    Координаты участков по умолчанию (если у участка нет своих координат)
DEFAULT_LAT=56.8389
DEFAULT_LON=60.6057
#    Город по умолчанию (подпись в прогнозе; меняется только здесь)
DEFAULT_CITY=Екатеринбург
#    Порог мороза: если ожидаемый минимум <= этого значения, будет предупреждение
FROST_THRESHOLD_C=0
#    Порог сильного ветра, км/ч
WIND_THRESHOLD_KMH=40
#    Порог заметного дождя, мм/сутки
RAIN_THRESHOLD_MM=1

# 8) Погодные проверки по умолчанию включены для участков с этими словами
#    (через запятую, в нижнем регистре)
WEATHER_WORKTYPES=монтаж,монтажные работы,кровля,кровельные работы,бетон,бетонирование,фасад,сварка,высотные работы
